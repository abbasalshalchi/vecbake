# Sibling repositories, each tracked separately.
# (gitignore has no inline comments -- these must stay on their own lines.)
# lerpa: the npm player package
lerpa/
# lerpa-website: lerpafiles.com
lerpa-website/
# demo: butterfly swarm example site
demo/

# Bake output and comparison images. Regenerated by any bake, and a bake of a
# scene nobody else has is not reproducible anyway, so tracking it only grows
# the history. Kept on disk, just not in git.
out/
snapshots/

# The play harness imports the player from lerpa/src; a copy beside it would
# drift silently.
tools/player.js


# Claude Code local dev server config
.claude/
